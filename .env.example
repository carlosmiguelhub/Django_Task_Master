# Set these in the environment used to start Django.
OPENAI_API_KEY=your_api_key_here
OPENAI_DAILY_PLAN_MODEL=gpt-5.6-terra

# Local development prints password-reset emails in the Django terminal.
# Configure an SMTP backend and provider credentials in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Task Master <no-reply@taskmaster.local>
